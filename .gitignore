# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user state and local build products
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcarchive/
*.dSYM/

# Swift Package Manager / local tooling
.build/
.swiftpm/configuration/
.swiftpm/xcode/

# Release artifacts (generated by scripts/package_app.sh)
dist/
*.app/
*.dmg
*.pkg
*.zip
SHA256SUMS

# Local logs and temporary files
*.log
*.orig
*.profraw
*.swp
*.swo

# Local secrets; keep a checked-in example file if needed.
.env
.env.*
!.env.example
